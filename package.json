{
  "name": "@novacraft-engineering/pulsar-code-push",
  "version": "1.9.2",
  "description": "Pulsar OTA client for React Native \u2014 over-the-air JavaScript updates. A CodePush-compatible client (RevoPush lineage) pointed at Pulsar.",
  "main": "CodePush.js",
  "typings": "typings/react-native-code-push.d.ts",
  "exports": {
    ".": {
      "types": "./typings/react-native-code-push.d.ts",
      "default": "./CodePush.js"
    },
    "./update": {
      "types": "./typings/update.d.ts",
      "default": "./update.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "typesVersions": {
    "*": {
      "update": [
        "typings/update.d.ts"
      ]
    }
  },
  "homepage": "https://usepulsar.dev",
  "bugs": {
    "url": "https://github.com/Novacraft-Africa/pulsar-code-push/issues"
  },
  "keywords": [
    "code-push",
    "codepush",
    "codepush-alternative",
    "hot-update",
    "ota",
    "ota-updates",
    "over-the-air",
    "pulsar",
    "react-native",
    "react-native-ota"
  ],
  "author": "Novacraft Engineering",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Novacraft-Africa/pulsar-code-push.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test"
  },
  "files": [
    "CodePush.js",
    "AlertAdapter.js",
    "targeting.js",
    "update.js",
    "update-config.js",
    "update-controller.js",
    "dev-guard.js",
    "UpdateSheet.js",
    "logging.js",
    "package-mixins.js",
    "request-fetch-adapter.js",
    "acquisition-sdk.js",
    "code-push-error.js",
    "react-native.config.js",
    "CodePush.podspec",
    "android",
    "ios",
    "scripts",
    "typings",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "hoist-non-react-statics": "^3.3.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.70.0"
  },
  "rnpm": {
    "android": {
      "packageInstance": "new CodePush(getResources().getString(R.string.CodePushDeploymentKey), getApplicationContext(), BuildConfig.DEBUG)"
    },
    "ios": {
      "sharedLibraries": [
        "libz"
      ]
    }
  }
}
